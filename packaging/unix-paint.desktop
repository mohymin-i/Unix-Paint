[Desktop Entry]
Type=Application
Name=Paint
GenericName=Image Editor
Comment=Draw, paint and edit pictures
Exec=unix-paint %f
Icon=unix-paint
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/x-icon;
StartupWMClass=unix-paint
